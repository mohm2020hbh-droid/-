{
  "name": "pogo-summit",
  "version": "0.1.0",
  "private": true,
  "description": "Pogo Summit \u2014 Android landscape pogo-climbing game (web core + native Android shell)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch",
    "qa": "node tools/qa-screenshots.mjs",
    "docs:physics": "tsx tools/docs-physics.ts",
    "qa:compare": "python3 ../tools/qa-compare.py ../reference/gameplay_reference.webp",
    "map": "tsx tools/map-cli.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/baloo-bhaijaan-2": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
